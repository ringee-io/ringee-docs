{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "maple",
  "name": "Ringee Documentation",
  "colors": {
    "primary": "#737373",
    "light": "#737373",
    "dark": "#737373"
  },
  "favicon": "/favicon.ico",
  "navigation": {
    "tabs": [
      {
        "tab": "Documentation",
        "groups": [
          {
            "group": "Getting Started",
            "pages": [
              "introduction",
              "howitworks",
              "quickstart"
            ]
          },
          {
            "group": "Installation",
            "pages": [
              "installation/docker-compose",
              "installation/docker",
              "installation/development"
            ]
          },
          {
            "group": "Configuration",
            "pages": [
              "configuration/reference",
              "configuration/docker-compose",
              "configuration/email",
              "configuration/r2",
              "configuration/stripe",
              "configuration/clerk"
            ]
          },
          {
            "group": "Telephony Providers",
            "pages": [
              "providers/overview",
              "providers/add-provider",
              "providers/telnyx"
            ]
          }
        ]
      }
    ],
    "global": {
      "anchors": [
        {
          "anchor": "GitHub",
          "href": "https://github.com/ringee-io/ringee",
          "icon": "github"
        },
        {
          "anchor": "YouTube",
          "href": "https://youtube.com/@RingeeOfficial",
          "icon": "youtube"
        }
      ]
    }
  },
  "logo": {
    "light": "/logo/light.png",
    "dark": "/logo/dark.png"
  },
  "navbar": {
    "links": [
      {
        "icon": "github",
        "label": "GitHub",
        "href": "https://github.com/ringee-io/ringee"
      }
    ],
    "primary": {
      "type": "button",
      "label": "Get Started",
      "href": "https://ringee.io"
    }
  },
  "contextual": {
    "options": [
      "copy",
      "view",
      "chatgpt",
      "claude",
      "cursor"
    ]
  },
  "footer": {
    "socials": {
      "x": "https://x.com/RingeeIO",
      "github": "https://github.com/ringee-io/ringee"
    }
  }
}
