{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "maple",
  "name": "Ringee Documentation",
  "colors": {
    "primary": "#059669",
    "light": "#34D399",
    "dark": "#047857"
  },
  "favicon": "/favicon.ico",
  "styling": {
    "eyebrows": "breadcrumbs",
    "codeblocks": {
      "theme": {
        "light": "github-light",
        "dark": "github-dark-dimmed"
      }
    }
  },
  "api": {
    "openapi": "api/openapi.json",
    "params": {
      "expanded": "all"
    },
    "playground": {
      "display": "simple"
    },
    "examples": {
      "languages": ["curl", "javascript", "python", "php", "go"],
      "defaults": "required"
    },
    "url": "full"
  },
  "navigation": {
    "tabs": [
      {
        "tab": "Documentation",
        "icon": "book-open",
        "groups": [
          {
            "group": "Getting Started",
            "icon": "rocket",
            "pages": [
              "introduction",
              "howitworks",
              "quickstart",
              "build-on-ringee"
            ]
          },
          {
            "group": "Installation",
            "icon": "download",
            "pages": [
              "installation/docker-compose",
              "installation/docker",
              "installation/development"
            ]
          },
          {
            "group": "Configuration",
            "icon": "gear",
            "pages": [
              "configuration/reference",
              "configuration/docker-compose",
              "configuration/email",
              "configuration/r2",
              "configuration/stripe",
              "configuration/clerk"
            ]
          },
          {
            "group": "Telephony Providers",
            "icon": "tower-broadcast",
            "pages": [
              "providers/overview",
              "providers/add-provider",
              "providers/telnyx"
            ]
          }
        ]
      },
      {
        "tab": "Public API",
        "icon": "code",
        "groups": [
          {
            "group": "Get Started",
            "icon": "key",
            "pages": ["api/overview", "api/authentication"]
          },
          {
            "group": "CRM to Ringee",
            "icon": "arrow-right-to-bracket",
            "pages": ["api/inbound-events", "api/click-to-call"]
          },
          {
            "group": "Ringee to CRM",
            "icon": "arrow-right-from-bracket",
            "pages": ["api/outbound-webhooks", "api/events-reference"]
          },
          {
            "group": "Guides",
            "icon": "book",
            "pages": ["api/build-an-integration", "api/logs-and-errors"]
          }
        ]
      },
      {
        "tab": "MCP",
        "icon": "robot",
        "groups": [
          {
            "group": "Get Started",
            "icon": "plug",
            "pages": ["mcp/overview", "mcp/connect"]
          },
          {
            "group": "Reference",
            "icon": "list",
            "pages": ["mcp/tools", "mcp/workspaces", "mcp/safety"]
          },
          {
            "group": "Apps",
            "icon": "puzzle-piece",
            "pages": ["mcp/apps"]
          }
        ]
      },
      {
        "tab": "CLI",
        "icon": "terminal",
        "groups": [
          {
            "group": "Get Started",
            "icon": "rocket",
            "pages": ["cli/overview", "cli/configuration"]
          },
          {
            "group": "Reference",
            "icon": "list",
            "pages": ["cli/commands", "cli/agents"]
          }
        ]
      },
      {
        "tab": "AI Voice Agents",
        "icon": "robot",
        "groups": [
          {
            "group": "Get Started",
            "icon": "rocket",
            "pages": ["voice-agents/overview", "voice-agents/quickstart"]
          },
          {
            "group": "Build an Agent",
            "icon": "sliders",
            "pages": [
              "voice-agents/configuration",
              "voice-agents/knowledge-analysis",
              "voice-agents/calls"
            ]
          },
          {
            "group": "Automation",
            "icon": "code",
            "pages": [
              "voice-agents/api-reference",
              "voice-agents/mcp",
              "voice-agents/cli"
            ]
          },
          {
            "group": "Operations",
            "icon": "gear",
            "pages": ["voice-agents/self-hosting"]
          }
        ]
      },
      {
        "tab": "Dialer SDK",
        "icon": "phone",
        "groups": [
          {
            "group": "Get Started",
            "icon": "rocket",
            "pages": [
              "dialer-sdk/overview",
              "dialer-sdk/quickstart",
              "dialer-sdk/publishable-keys"
            ]
          },
          {
            "group": "Integration Modes",
            "icon": "layer-group",
            "pages": [
              "dialer-sdk/floating",
              "dialer-sdk/bar",
              "dialer-sdk/headless"
            ]
          },
          {
            "group": "Guides",
            "icon": "book",
            "pages": [
              "dialer-sdk/react",
              "dialer-sdk/contacts",
              "dialer-sdk/theming"
            ]
          },
          {
            "group": "Reference",
            "icon": "code",
            "pages": ["dialer-sdk/reference", "dialer-sdk/errors"]
          },
          {
            "group": "Operations",
            "icon": "shield-halved",
            "pages": ["dialer-sdk/security", "dialer-sdk/troubleshooting"]
          }
        ]
      }
    ],
    "global": {
      "anchors": [
        {
          "anchor": "GitHub",
          "href": "https://github.com/ringee-io/ringee-app",
          "icon": "github"
        },
        {
          "anchor": "YouTube",
          "href": "https://youtube.com/@RingeeOfficial",
          "icon": "youtube"
        }
      ]
    }
  },
  "logo": {
    "light": "/logo/light.png",
    "dark": "/logo/dark.png"
  },
  "navbar": {
    "links": [
      {
        "icon": "github",
        "label": "GitHub",
        "href": "https://github.com/ringee-io/ringee-app"
      }
    ],
    "primary": {
      "type": "button",
      "label": "Get Started",
      "href": "https://ringee.io"
    }
  },
  "contextual": {
    "options": ["copy", "view", "chatgpt", "claude", "cursor"]
  },
  "footer": {
    "socials": {
      "x": "https://x.com/RingeeIO",
      "github": "https://github.com/ringee-io/ringee-app"
    }
  }
}
